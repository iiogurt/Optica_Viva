    "ci": "npm run check && npm test && npm run smoke",
    "bench": "node scripts/bench.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiogurt/Optica_Viva.git"
  },
  "engines": {
    "node": ">=22"
  }
}
