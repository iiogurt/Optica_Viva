{
  "name": "optica-viva",
  "version": "1.18.0",
  "license": "MIT",
  "description": "Interactive, physically exact simulations of optical phenomena in photography, cinematography and space telescopes.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
