{
  "name": "optica-viva",
  "version": "1.1.0",
  "description": "Interactive, physically exact simulations of optical phenomena in photography, cinematography and space telescopes.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test test/",
    "check": "node scripts/check.mjs",
    "smoke": "node --experimental-websocket scripts/smoke.mjs",
    "ci": "npm run check && npm test && npm run smoke",
    "bench": "node scripts/bench.mjs",
    "screenshots": "node --experimental-websocket scripts/screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiogurt/Optica_Viva.git"
  },
  "engines": {
    "node": ">=20"
  }
}
